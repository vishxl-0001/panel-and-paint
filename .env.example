# =========================================================================
# Ngongotaha Panel & Paint - Environment Variables
# =========================================================================

# Supabase Credentials (Optional for local development; app has instant zero-config fallback)
NEXT_PUBLIC_SUPABASE_URL=https://your-supabase-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Service Role Key (Used for server-side admin functions if needed)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# Public App URL (For OpenGraph and Canonical metadata)
NEXT_PUBLIC_SITE_URL=https://ngongotahapanelpaint.co.nz
